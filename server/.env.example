NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lrcmis_dev?schema=public

# Authentication (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Business policy
BUSINESS_TIMEZONE=Asia/Jakarta
MIN_WEIGHT_KG=3
WEIGHT_ROUNDING_KG=0.5
DEFAULT_DELIVERY_FEE=5000
RESERVATION_CANCEL_CUTOFF_HOURS=2

# Development helper: return password-reset token in the API response.
# MUST be false in production. Email delivery is the normal reset flow.
EXPOSE_RESET_TOKEN=false

# Resend email delivery (required in production).
# EMAIL_FROM must use a domain verified in Resend.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LRC MIS <server@your-verified-domain.com>"

# Optional primary administrator setup (used only by `npm run db:setup-admin`).
# If PRIMARY_ADMIN_PASSWORD is omitted, a strong password is generated and printed once.
PRIMARY_ADMIN_EMAIL=admin@lrcmis.id
PRIMARY_ADMIN_NAME=Administrator Utama
PRIMARY_ADMIN_PASSWORD=

# Optional integrations
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
PAYMENT_GATEWAY_KEY=
