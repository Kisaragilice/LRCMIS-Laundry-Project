# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Local development example. Docker Compose exposes PostgreSQL on port 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lrcmis_dev?schema=public
# For Docker: postgresql://lrcmis:lrcmis@localhost:5433/lrcmis?schema=public

# ── Authentication ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# ── Business policy ────────────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Jakarta
# Minimum billable weight for kg-based services (kg)
MIN_WEIGHT_KG=3
# Billable weight is rounded UP to this increment (kg)
WEIGHT_ROUNDING_KG=0.5
# Default pickup/delivery fee in IDR
DEFAULT_DELIVERY_FEE=5000
# Reservations may only be cancelled this many hours before the slot starts
RESERVATION_CANCEL_CUTOFF_HOURS=2

# ── Optional password reset demo helper ────────────────────────────────────
# When true, POST /auth/forgot-password returns the reset token in the response.
# MUST be false in production.
# Turn this off after email delivery is verified.
EXPOSE_RESET_TOKEN=true

# ── Optional integrations (leave empty to disable) ─────────────────────────
# Resend is required in production. EMAIL_FROM must use a verified Resend domain.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LRC MIS <server@your-verified-domain.com>"
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
PAYMENT_GATEWAY_KEY=
