# Local development environment (copy to server/.env).
# For Docker Compose on a server, use .env.docker.example instead.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lrcmis_dev?schema=public

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Business policy
BUSINESS_TIMEZONE=Asia/Jakarta
MIN_WEIGHT_KG=3
WEIGHT_ROUNDING_KG=0.5
DEFAULT_DELIVERY_FEE=5000
RESERVATION_CANCEL_CUTOFF_HOURS=2

# Password reset. Email (Resend) is the normal delivery channel.
# This helper must remain false in production.
EXPOSE_RESET_TOKEN=false

# Resend email delivery (required in production)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LRC MIS <server@your-verified-domain.com>"

# Optional integrations (leave empty to disable)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
PAYMENT_GATEWAY_KEY=
