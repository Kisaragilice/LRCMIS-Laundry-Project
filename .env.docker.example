# ============================================================================
# LRCMIS Docker Compose environment
# Copy this file to .env on the server, then replace every placeholder.
#   cp .env.docker.example .env
#   chmod 600 .env
# ============================================================================

NODE_ENV=production

# Required. Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Cookie policy. Keep this true for deployments that use HTTPS.
# The API chooses the Secure flag per request: HTTPS gets Secure cookies, plain
# HTTP LAN requests get normal cookies. That makes one deployment work through
# both https://your-domain and http://192.168.1.10:9999.
COOKIE_SECURE=true

# Origin of the web UI. Comma-separated list is supported, for example:
#   CLIENT_ORIGIN=https://laundry.kisaragilice.my.id,http://192.168.1.10:9999
# Same-origin requests through the bundled Nginx are always accepted, so this
# list is mainly needed when the UI and API are served from different origins.
CLIENT_ORIGIN=https://laundry.kisaragilice.my.id

# Canonical public URL used for links in emails (password reset). This must be
# the domain users open in the browser, never a LAN IP or localhost.
PUBLIC_APP_URL=https://laundry.kisaragilice.my.id

# Required. Use random hex so the value is safe inside DATABASE_URL.
# Generate with: openssl rand -hex 24
POSTGRES_DB=lrcmis
POSTGRES_USER=lrcmis
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# Host ports. PostgreSQL and the API stay on localhost for safety.
# WEB_BIND=127.0.0.1 is correct when cloudflared/Caddy runs on the same host.
# For direct access from other LAN devices, use WEB_BIND=0.0.0.0 and restrict
# the port with the host firewall.
POSTGRES_PORT=5433
API_PORT=4000
WEB_BIND=127.0.0.1
WEB_PORT=9999

# Keep this false: reset tokens must only be delivered by email.
EXPOSE_RESET_TOKEN=false

# Required in production. Use a Resend API key and a sender on a verified domain.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LRC MIS <server@kisaragilice.my.id>"

# Idempotent reference-data seed on API startup (roles, services, slots, promos).
RUN_SEED=true

# Optional integrations. Leave empty to disable.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
PAYMENT_GATEWAY_KEY=
