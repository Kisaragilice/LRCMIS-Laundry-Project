# ============================================================================
# LRCMIS Docker Compose environment
# Copy this file to .env on the server, then replace every placeholder.
#   cp .env.docker.example .env
#   chmod 600 .env
# ============================================================================

NODE_ENV=production

# Required. Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Production must use HTTPS, so this must be true.
# For local HTTP-only testing, set NODE_ENV=development and COOKIE_SECURE=false.
COOKIE_SECURE=true
CLIENT_ORIGIN=https://lrcmis.example.com

# Required. Use random hex so the value is safe inside DATABASE_URL.
# Generate with: openssl rand -hex 24
POSTGRES_DB=lrcmis
POSTGRES_USER=lrcmis
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# Host ports are bound to 127.0.0.1 by default.
POSTGRES_PORT=5433
API_PORT=4000
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Keep this false: reset tokens must only be delivered by email.
EXPOSE_RESET_TOKEN=false

# Required in production. Use a Resend API key and a sender on a verified domain.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="LRC MIS <server@your-verified-domain.com>"

# Idempotent reference-data seed on API startup (roles, services, slots, promos).
RUN_SEED=true

# Optional integrations. Leave empty to disable.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
PAYMENT_GATEWAY_KEY=
