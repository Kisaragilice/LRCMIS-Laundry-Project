# Leave empty to use the Vite dev proxy / same-origin Nginx proxy.
# Example for a separately hosted API: http://localhost:4000/api/v1
VITE_API_URL=

# Leaflet map tiles. Defaults to OpenStreetMap (no account or API key needed).
# For higher traffic, point this at a tile provider such as MapTiler, Stadia,
# or Carto, and update the attribution text to match the provider.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
